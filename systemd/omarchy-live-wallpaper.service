[Unit]
Description=Omarchy Live Video Wallpaper Daemon (mpvpaper)
Documentation=https://github.com/YOUR-USERNAME/omarchy-aesthetic-themes
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.local/state/omarchy/live-wallpaper.env
ExecStart=%h/.local/bin/mpvpaper -p -l bottom -o "no-audio ao=null load-scripts=no hwdec=auto-safe profile=fast interpolation=no input-ipc-server=/tmp/mpvpaper-ipc.sock loop loop-playlist" ALL ${VIDEO_PATH}
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
